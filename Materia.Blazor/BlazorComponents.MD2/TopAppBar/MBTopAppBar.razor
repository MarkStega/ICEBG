@namespace Materia.Blazor.MD2
@inherits ComponentFoundationMD2


<header @ref="HeaderElem"
        class="mdc-top-app-bar @(@class)"
        style="@style"
        id="@id">

    <div class="mdc-top-app-bar__row">
        <section class="mdc-top-app-bar__section mdc-top-app-bar__section--align-start">
            <MBMenu AnchorType="MBMenuAnchorType.Icon"
                    IconDescriptor="@MBIcon.IconDescriptorConstructor(
                                    name: "menu",
                                    color: "white")"
                    MenuItems="@MenuItems"
                    MenuPositioning="MBMenuPositioning.Popover"
                    @onmenuselectionreport="SelectionReport" />

            <span class="mdc-top-app-bar__title">@Title</span>
        </section>
        <section class="mdc-top-app-bar__section mdc-top-app-bar__section--align-end" style="padding-right: 20px;">
            @if (ChildContent != null)
            {
                @ChildContent
            }
        </section>
    </div>
</header>
