@page "/"

@namespace ICEBG.Client

@using ICEBG.Client.Components
@using ICEBG.DataTier.DataDefinitions
@using ICEBG.DataTier.gRPCClient
@using ICEBG.DataTier.HelperClasses
@using ICEBG.DataTier.Interfaces
@using ICEBG.SharedUtilities
@using ICEBG.SystemFramework

@inject iConfigurationClient ConfigurationClient

@implements IDisposable


@inherits ComponentBase


<div class="dw-section-regular">
    <div class="dw-max-width-content">
        <div class="mdc-layout-grid">
            <div class="mdc-layout-grid__inner">
                <div class="mdc-layout-grid__cell--span-12 dw-tagline">
                    @if (pBurn)
                    {
                        <h1>Report on consumed resources</h1>
                        <FlowLabeledText2 time="@currentTime.ToString()"
                                          duration="@duration"
                                          statisticsReportResult="@currentStatisticsReport" />
                    }
                    else
                    {
                        <div class="dw-picture-right">
                            <p class="mdc-typography--headline4">More work...</p>
                            <p class="mdc-typography--body1">
                                We need these shelves organized.
                            </p>

                            <br />
                        </div>

                        <img src="_content/ICEBG.Client/images/book-shelves.jpg" alt="book-shelves" width="640px" height="420px">
                        <br />
                    }
                </div>

            </div>
        </div>
    </div>
</div>

